# ── Required per environment (canonical Vercel set) ──────────────────────────
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_AUTH_BASE_URL=
NEXT_PUBLIC_CERT_TENANT_SLUG=
# Legacy, unread by code (rewrite-era leftover, still set on Vercel) — do not use:
# NEXT_PUBLIC_CERT_API_URL=

# ── BFF proxy targets (server-side only, no NEXT_PUBLIC prefix) ─────────────
# Local dev needs these (BFF defaults point at production hosts):
CERT_API_URL=
AUTH_API_URL=

# ── Optional UI flags ──────────────────────────────────────────────────────
# NEXT_PUBLIC_DEMO=true
# NEXT_PUBLIC_VERSION=
