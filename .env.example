# Local Development Environment
# Copy to .env.local and adjust as needed

# UI base URL (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth Platform (SSO login redirect)
# Use real Auth Platform or leave as-is for SSO redirect in dev
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.lyceumalabang.edu.ph

# Cert API
# Set to "mock" for local dev (uses Express mock server on localhost:3001)
# Set to "live" when Cert API is deployed and C-Auth phase is complete
NEXT_PUBLIC_CERT_API_TARGET=mock

# Tenant slug for JWT validation
NEXT_PUBLIC_CERT_TENANT_SLUG=loa
