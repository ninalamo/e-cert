# Local Development Environment
# Copy to .env.local and adjust as needed

## ── Stack switch ────────────────────────────────────────────────────────
## true  → target local Docker services (auth :8080, cert nginx :9001)
## unset / false → target cPanel deployments
USE_LOCAL_STACK=true

# UI base URL (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Tenant slug for JWT validation (must match the tenants table slug)
NEXT_PUBLIC_CERT_TENANT_SLUG=loa-e-cert

## ── cPanel targets (only when USE_LOCAL_STACK is unset/false) ───────────
# CPANEL_AUTH_BASE_URL=https://auth.lyceumalabang.edu.ph
# CPANEL_CERT_API_URL=https://cert-api.lyceumalabang.edu.ph

# NOTE: NEXT_PUBLIC_AUTH_BASE_URL, AUTH_API_TARGET and NEXT_PUBLIC_CERT_API_TARGET
# are derived by next.config.ts — do not set them manually.
# Restart `npm run dev` after changing USE_LOCAL_STACK (rewrites are start-time).
