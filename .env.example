# ── Required per environment ────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_AUTH_BASE_URL=
NEXT_PUBLIC_CERT_API_URL=
NEXT_PUBLIC_CERT_TENANT_SLUG=

# ── Supabase (required — env.ts validates at startup) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── SMTP (required — env.ts validates at startup) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Optional UI flags ──────────────────────────────────────────────────────
# NEXT_PUBLIC_DEMO=true
# NEXT_PUBLIC_VERSION=
